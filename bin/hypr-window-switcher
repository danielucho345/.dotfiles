#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'EOF'
Usage: hypr-window-switcher [legacy | list --json | focus <address> | view [compact|monitors]]

List open windows on regular Hyprland workspaces and focus the selected one.
EOF
}

fail() {
  echo "hypr-window-switcher: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

clean_text() {
  # Hyprland titles may contain tabs or newlines; keep every entry on one menu
  # row, and leave printable UTF-8 text intact.
  tr '[:cntrl:]' ' ' <<<"$1" | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//'
}

require_command hyprctl
require_command jq

snapshot() {
  local clients workspaces monitors
  clients="$(hyprctl -j clients)" || fail "could not query open windows"
  workspaces="$(hyprctl -j workspaces)" || fail "could not query workspaces"
  monitors="$(hyprctl -j monitors)" || fail "could not query monitors"
  jq -en --argjson clients "$clients" --argjson workspaces "$workspaces" --argjson monitors "$monitors" '
    if ([$clients, $workspaces, $monitors] | all(.[]; type == "array")) then
      {monitors: ($monitors | sort_by(.x, .y, .name)),
       windows: [$clients[] | select(.mapped != false and .workspace.id >= 0)
         | . as $c | ($workspaces | map(select(.id == $c.workspace.id)) | first) as $w
         | {address, class, initialClass, title, initialTitle, pid,
            workspace: .workspace.id, workspaceName: (.workspace.name // (.workspace.id | tostring)),
            monitor: ($w.monitor // "")}]
      }
    else error("Invalid Hyprland response") end'
}

focus_address() {
  local address="$1" data target workspace monitor response actual
  [[ "$address" =~ ^0x[[:xdigit:]]+$ ]] || fail "invalid window address"
  data="$(snapshot)" || fail "could not refresh window data"
  target="$(jq -ec --arg address "$address" '.windows[] | select(.address == $address)' <<<"$data")" \
    || fail "that window is no longer available on a regular workspace"
  workspace="$(jq -r .workspace <<<"$target")"
  monitor="$(jq -r .monitor <<<"$target")"
  jq -e --arg monitor "$monitor" 'any(.monitors[]; .name == $monitor)' <<<"$data" >/dev/null \
    || fail "that window has no connected monitor"
  # JSON string quoting also protects connector names in Lua dispatcher text.
  response="$(hyprctl dispatch "hl.dsp.focus({ monitor = $(jq -Rn --arg v "$monitor" '$v') })" 2>/dev/null)" || response=""
  [[ "$response" == ok ]] || hyprctl dispatch focusmonitor "$monitor" >/dev/null
  response="$(hyprctl dispatch "hl.dsp.focus({ workspace = \"$workspace\" })" 2>/dev/null)" || response=""
  [[ "$response" == ok ]] || hyprctl dispatch workspace "$workspace" >/dev/null
  response="$(hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" 2>/dev/null)" || response=""
  [[ "$response" == ok ]] || hyprctl dispatch focuswindow "address:$address" >/dev/null
  for _ in {1..10}; do
    actual="$(hyprctl -j activewindow | jq -r '.address // ""')" || actual=""
    [[ "$actual" == "$address" ]] && return 0
    sleep 0.05
  done
  fail "Hyprland did not focus the selected window"
}

view_state() {
  local dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/window-switcher" tmp
  if (($# == 0)); then
    jq -er '.view | select(. == "compact" or . == "monitors")' "$dir/state.json" 2>/dev/null || printf '%s\n' compact
    return
  fi
  [[ "$1" == compact || "$1" == monitors ]] || fail "unknown view: $1"
  mkdir -p "$dir"
  tmp="$(mktemp "$dir/.state.XXXXXX")"
  jq -n --arg view "$1" '{view: $view}' > "$tmp"
  mv -- "$tmp" "$dir/state.json"
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  list) [[ "$#" == 2 && "$2" == --json ]] || fail "use list --json"; snapshot; exit ;;
  focus) [[ "$#" == 2 ]] || fail "focus requires an address"; focus_address "$2"; exit ;;
  view) shift; (($# <= 1)) || fail "view accepts one layout"; view_state "$@"; exit ;;
  legacy) (($# == 1)) || fail "legacy accepts no arguments" ;;
  '')
    if command -v omarchy-shell >/dev/null &&
       plugins="$(omarchy-shell shell listPlugins 2>/dev/null)" &&
       jq -e 'any(.[]; .id == "daniel.window-switcher" and .enabled)' <<<"$plugins" >/dev/null; then
      if omarchy-shell shell toggle daniel.window-switcher '{}'; then
        # An enabled manifest can still have an unavailable/broken entry point.
        # Confirm that an actual panel instance answered before skipping legacy.
        for _ in {1..3}; do
          if omarchy-shell shell call daniel.window-switcher status '{}' 2>/dev/null |
             jq -e 'has("opened")' >/dev/null 2>&1; then exit 0; fi
          sleep 0.05
        done
      fi
    fi
    ;;
  *) usage >&2; exit 2 ;;
esac
require_command omarchy

clients_json="$(hyprctl -j clients)" || fail "could not query open windows"
workspaces_json="$(hyprctl -j workspaces)" || fail "could not query workspaces"

declare -a options=()
declare -a addresses=()
declare -a workspace_ids=()
declare -a monitors=()
index=1

# NUL-delimited fields preserve empty titles/classes and literal backslashes.
while IFS= read -r -d '' workspace_id &&
      IFS= read -r -d '' app &&
      IFS= read -r -d '' title &&
      IFS= read -r -d '' address &&
      IFS= read -r -d '' workspace_name &&
      IFS= read -r -d '' monitor; do
  app="$(clean_text "$app")"
  title="$(clean_text "$title")"
  workspace_name="$(clean_text "$workspace_name")"
  monitor="$(clean_text "$monitor")"

  [[ -n "$app" ]] || app="Unknown application"
  [[ -n "$title" ]] || title="Untitled window"
  [[ -n "$workspace_name" ]] || workspace_name="$workspace_id"
  [[ -n "$monitor" ]] || monitor="Unknown monitor"

  options+=("󰖯"$'\t'"${index}. ${app} — ${title}"$'\t'"Workspace ${workspace_name} · ${monitor}")
  addresses[index]="$address"
  workspace_ids[index]="$workspace_id"
  monitors[index]="$monitor"
  ((index += 1))
done < <(
  jq -j -n \
    --argjson clients "$clients_json" \
    --argjson workspaces "$workspaces_json" '
      [$workspaces[]
       | select(.id >= 0)
       | { key: (.id | tostring), value: (.monitor // "Unknown monitor") }]
      | from_entries as $monitor_by_workspace
      | [$clients[]
         | select(.workspace.id >= 0)
         | {
             workspace_id: .workspace.id,
             workspace_name: (.workspace.name // (.workspace.id | tostring)),
             monitor: ($monitor_by_workspace[(.workspace.id | tostring)] // "Unknown monitor"),
             app: (.class // .initialClass // "Unknown application"),
             title: (.title // .initialTitle // "Untitled window"),
             address: .address
           }]
      | sort_by(.workspace_id, (.app | ascii_downcase), (.title | ascii_downcase))
      | .[]
      | [
          (.workspace_id | tostring),
          .app,
          .title,
          .address,
          .workspace_name,
          .monitor
        ]
      | .[] | ., "\u0000"'
)

if ((${#options[@]} == 0)); then
  echo "hypr-window-switcher: no windows are open on regular workspaces" >&2
  exit 0
fi

selection="$(omarchy menu select "Find open window" "${options[@]}" -- --width 640 --maxheight 600)" || exit 0

if [[ ! $selection =~ ^([0-9]+)\. ]]; then
  fail "could not identify the selected window"
fi

selected_index="${BASH_REMATCH[1]}"
address="${addresses[selected_index]:-}"
workspace_id="${workspace_ids[selected_index]:-}"
monitor="${monitors[selected_index]:-}"
[[ -n "$address" ]] || fail "selected window is no longer available"
[[ -n "$workspace_id" ]] || fail "selected window has no regular workspace"

# Re-query here too: legacy results can become stale while the menu is open.
focus_address "$address"
