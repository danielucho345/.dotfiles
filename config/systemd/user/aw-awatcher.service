[Unit]
Description=ActivityWatch native Wayland window and idle watcher
After=graphical-session.target aw-server-rust.service
Requires=aw-server-rust.service
PartOf=graphical-session.target

[Service]
Type=simple
TimeoutStartSec=120
ExecStartPre=/usr/bin/bash -c 'until /usr/bin/curl --fail --silent --max-time 1 http://127.0.0.1:5600/api/0/info > /dev/null; do /usr/bin/sleep 1; done'
ExecStart=%h/.local/bin/awatcher --host 127.0.0.1 --port 5600 --idle-timeout 180 --poll-time-idle 4 --poll-time-window 1
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
